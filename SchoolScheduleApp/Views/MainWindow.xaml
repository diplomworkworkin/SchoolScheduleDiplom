<Window x:Class="SchoolScheduleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SchoolScheduleApp.ViewModels"
        mc:Ignorable="d"
        Title="Вход в систему" Height="650" Width="1000"
        MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0f2027">

    <!-- Ресурсы для конвертации (нужны для чекбокса) -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <!-- Подключаем ViewModel -->
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <!-- Основной контейнер с закруглением -->
    <Border CornerRadius="20">
        <!-- ТЕМНЫЙ ФОН ГРАДИЕНТОМ -->
        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#0f2027" Offset="1"/>
                <GradientStop Color="#203a43" Offset="0.5"/>
                <GradientStop Color="#2c5364" Offset="0"/>
            </RadialGradientBrush>
        </Border.Background>

        <Grid>
            <!-- 1. ДЕКОРАЦИИ (Свечение) -->
            <Ellipse Width="300" Height="300" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-50,-50,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4000d2ff" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse Width="400" Height="400" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-100,-100">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2000d2ff" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- 2. ЦЕНТРАЛЬНАЯ СТЕКЛЯННАЯ КАРТОЧКА -->
            <Border MinWidth="300" MinHeight="420" MaxWidth="380" MaxHeight="500"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40"
                    CornerRadius="25" BorderBrush="#33FFFFFF" BorderThickness="1.5">

                <!-- Полупрозрачный фон самой карточки -->
                <Border.Background>
                    <SolidColorBrush Color="#10FFFFFF"/>
                </Border.Background>

                <Border.Effect>
                    <!-- Эффект тени (Neon Glow) -->
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#00d2ff" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="40">

                        <!-- ЛОГОТИП (Круг с иконкой) -->
                        <Border Width="80" Height="80" CornerRadius="40" 
                                BorderBrush="#00d2ff" BorderThickness="2" Margin="0,0,0,40">
                            <!-- Иконка шапочки выпускника (для школы) -->
                            <TextBlock Text="🎓" FontSize="30" Foreground="#00d2ff" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#00d2ff" ShadowDepth="0"/>
                            </Border.Effect>
                        </Border>

                        <!-- ПОЛЕ: ЛОГИН -->
                        <Border Height="50" CornerRadius="5" Background="#20000000" Margin="0,0,0,20">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TbLogin}" Value="True">
                                            <Setter Property="BorderBrush" Value="#00d2ff"/>
                                            <Setter Property="BorderThickness" Value="1.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="👤" Grid.Column="0" FontSize="16" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>

                                <TextBox x:Name="TbLogin"
                                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                         Grid.Column="1"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="14"
                                         VerticalContentAlignment="Center"
                                         Padding="0,0,10,0"
                                         CaretBrush="White">
                                </TextBox>

                                <!-- Линия подсветки (как у PasswordBox) -->
                                <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" Margin="12,0,12,0"
                                        Background="#00d2ff" Opacity="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TbLogin}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Плейсхолдер -->
                                <TextBlock Grid.Column="1" Text="Логин" IsHitTestVisible="False"
                                           Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="2,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Username}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Username}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Подсветка (как у пароля): линия снизу при фокусе -->
                                <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom"
                                        Background="#00d2ff" Opacity="0" Margin="10,0,10,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=TbLogin}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ПОЛЕ: ПАРОЛЬ -->
                       <Border Height="50" CornerRadius="5" Background="#20000000" Margin="0,0,0,20">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="50"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Иконка замка -->
        <TextBlock Text="🔒" Grid.Column="0" FontSize="16" Foreground="White"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"/>

        <!-- Само поле пароля -->
        <PasswordBox x:Name="UserPasswordBox"
                     Grid.Column="1"
                     Background="Transparent" BorderThickness="0"
                     Foreground="White" FontSize="14"
                     VerticalContentAlignment="Center"
                     Padding="0,0,10,0"
                     CaretBrush="White"
                     PasswordChanged="PasswordBox_PasswordChanged"/>

        <!-- Линия подсветки (под полем пароля) -->
        <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Bottom" Margin="12,0,12,0"
                Background="#00d2ff" Opacity="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=UserPasswordBox}" Value="True">
                            <Setter Property="Opacity" Value="1"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Плейсхолдер "Пароль" -->
        <TextBlock x:Name="PasswordPlaceholder"
                   Grid.Column="1" 
                   Text="Пароль" 
                   IsHitTestVisible="False"
                   Foreground="#80FFFFFF" 
                   VerticalAlignment="Center" 
                   Margin="2,0,0,0"/>

        <!-- (подсветка уже есть выше, оставляем одну линию) -->
    </Grid>
</Border>

                        <!-- ЧЕКБОКС И ССЫЛКА -->
                        <Grid Margin="0,0,0,30">
                            <CheckBox Content="Запомнить меня" Foreground="White" FontSize="12"
                                      HorizontalAlignment="Left" VerticalContentAlignment="Center"
                                      Cursor="Hand">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Кастомный квадрат чекбокса -->
                                            <Border Width="16" Height="16" CornerRadius="3" 
                                                    BorderBrush="White" BorderThickness="1" 
                                                    Background="Transparent" Margin="0,0,8,0">
                                                <!-- Галочка -->
                                                <Path Data="M 3,8 L 6,11 L 13,3" Stroke="#00d2ff" StrokeThickness="2"
                                                      Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </Border>
                                            <ContentPresenter/>
                                        </StackPanel>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>

                            <TextBlock Text="Забыли пароль?" Foreground="White" FontSize="12" 
                                       HorizontalAlignment="Right" Cursor="Hand" Opacity="0.7" 
                                       TextDecorations="Underline"/>
                        </Grid>

                        <!-- КНОПКА ВОЙТИ -->
                        <Button Content="В О Й Т И" Command="{Binding LoginCommand}" 
                                CommandParameter="{Binding ElementName=UserPasswordBox}"
                                Height="45" FontSize="14" FontWeight="Bold"
                                Foreground="White" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- Фон кнопки с прозрачностью -->
                                    <Border CornerRadius="5" Background="#25FFFFFF" BorderBrush="#00d2ff" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#4000d2ff"/>
                                                        <!-- Подсветка при наведении -->
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- СООБЩЕНИЕ ОБ ОШИБКЕ -->
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#ff6b6b" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,15,0,0" FontSize="12"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
