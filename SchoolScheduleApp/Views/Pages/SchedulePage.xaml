<Page x:Class="SchoolScheduleApp.Views.Pages.SchedulePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="SchedulePage">

    <Page.Resources>
        <!-- Цвета кнопки редактирования -->
        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <TextBlock Text="✎"
                                       FontSize="14"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        
        <!-- Фон карточек -->
        <Style x:Key="LessonCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="5,0,5,10"/>
        </Style>

        <!-- Стиль ComboBox, чтобы в темной теме текст был читаем -->
        <!-- Важно: BasedOn подтягивает общий шаблон ComboBox из App.xaml (с правильным Popup) -->
        <Style x:Key="TopComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>

        <!-- Читабельная таблица даже в темной теме -->
        <Style x:Key="ScheduleGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="RowBackground" Value="{DynamicResource InputBackground}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardBackground}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="36"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Вкладки расписания: аккуратный вид (под обе темы) -->
        <Style x:Key="ScheduleTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ScheduleTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                <Border x:Name="Underline" Height="2" Background="Transparent"
                                        VerticalAlignment="Bottom" CornerRadius="2"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter TargetName="Underline" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ВЕРХНЯЯ ПАНЕЛЬ -->
        <Border Grid.Row="0"
                Margin="0,0,0,20"
                Padding="0,0,0,15"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="0,0,0,1">
            <DockPanel>
                <StackPanel>
                    <TextBlock Text="Расписание занятий"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Text="Режим редактирования"
                               Foreground="{DynamicResource AccentColor}"
                               FontSize="12"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- ВЫБОР КЛАССА (вместо хардкода 11-А) -->
                    <Border CornerRadius="8"
                            Background="{DynamicResource InputBackground}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            Margin="0,0,15,0"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Класс: "
                                       Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center"/>

                            <ComboBox Style="{StaticResource TopComboBoxStyle}"
                                      Width="140"
                                      ItemsSource="{Binding Classes}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedClassId}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- КНОПКА АВТОСОСТАВЛЕНИЯ -->
                    <Button Content="⚡ Авто-составление"
                            Command="{Binding AutoGenerateScheduleCommand}"
                            Background="{DynamicResource AccentColor}"
                            Foreground="White"
                            FontWeight="Bold"
                            Padding="20,10"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ОСНОВНОЙ КОНТЕНТ (оставляем только табличный вид, без "Сетки") -->
        <Grid Grid.Row="1" Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Вкладки дней недели.
                         ВАЖНО: используем биндинг SelectedIndex, а не обработчик SelectionChanged.
                         Так вкладки точно работают во всех темах/стилях и не зависят от code-behind. -->
                    <TabControl Grid.Row="0"
                                Style="{StaticResource ScheduleTabControlStyle}"
                                SelectedIndex="{Binding SelectedDayTabIndex, Mode=TwoWay}">
                        <TabItem Header="Пн" Style="{StaticResource ScheduleTabItemStyle}"/>
                        <TabItem Header="Вт" Style="{StaticResource ScheduleTabItemStyle}"/>
                        <TabItem Header="Ср" Style="{StaticResource ScheduleTabItemStyle}"/>
                        <TabItem Header="Четверг" Style="{StaticResource ScheduleTabItemStyle}"/>
                        <TabItem Header="Пятница" Style="{StaticResource ScheduleTabItemStyle}"/>
                    </TabControl>

                    <!-- Табличный вид выбранного дня -->
                    <Border Grid.Row="1"
                            CornerRadius="14"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            Background="{DynamicResource CardBackground}"
                            ClipToBounds="True"
                            Margin="0,10,0,0">

                    <DataGrid ItemsSource="{Binding ScheduleTable}"
                              Style="{StaticResource WowDataGrid}"
                              materialDesign:DataGridAssist.CellPadding="10,6"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="10,8"
                              Margin="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Урок" Binding="{Binding DisplayLessonIndex}" Width="80"/>
                            <DataGridTextColumn Header="Предмет" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Учитель" Binding="{Binding Teacher}" Width="240"/>
                            <DataGridTextColumn Header="Кабинет" Binding="{Binding Classroom}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    </Border>
                </Grid>
    </Grid>
</Page>
