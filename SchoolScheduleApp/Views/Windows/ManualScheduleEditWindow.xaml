<Window x:Class="SchoolScheduleApp.Views.Windows.ManualScheduleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ручное редактирование расписания"
        Width="980"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Ручное редактирование расписания"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryText}"
                   Margin="0,0,0,12"/>

        <DataGrid x:Name="LessonsGrid"
                  Grid.Row="1"
                  ItemsSource="{Binding Lessons}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  RowHeaderWidth="0"
                  Background="{DynamicResource CardBackground}"
                  Foreground="{DynamicResource PrimaryText}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Урок" Binding="{Binding LessonIndex}" Width="80"/>
                <DataGridComboBoxColumn Header="Предмет"
                                        Width="*"
                                        SelectedValueBinding="{Binding SubjectId, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding DataContext.Subjects, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <DataGridComboBoxColumn Header="Учитель"
                                        Width="260"
                                        SelectedValueBinding="{Binding TeacherId, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="FullName"
                                        ItemsSource="{Binding DataContext.Teachers, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <DataGridComboBoxColumn Header="Кабинет"
                                        Width="190"
                                        SelectedValueBinding="{Binding ClassroomId, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="Id"
                                        DisplayMemberPath="Number"
                                        ItemsSource="{Binding DataContext.Classrooms, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="+ Урок"
                        Width="100"
                        Margin="0,0,8,0"
                        Click="BtnAddLesson_Click"/>
                <Button Content="Удалить урок"
                        Width="110"
                        Click="BtnDeleteLesson_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Width="95"
                        Margin="0,0,8,0"
                        Click="BtnCancel_Click"/>
                <Button Content="Сохранить"
                        Width="120"
                        Background="{DynamicResource AccentColor}"
                        Foreground="White"
                        Click="BtnSave_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
